# Variables de MCA Colaboración / TeamCalls para STAGING (ejemplo, fase 4I). Copiar SOLO al .env del servidor.
# NUNCA subir valores reales al repositorio. Los <…> los genera o rellena quien administra el servidor.

APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.example.com
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# Habilitación: deshabilitada por defecto; aquí se nombra el entorno. «production» se ignora siempre.
TEAMCALLS_UI_ENABLED=true
TEAMCALLS_UI_ENVIRONMENTS=staging
TEAMCALLS_UI_SYNTHETIC_MEDIA=false
TEAMCALLS_UI_INCOMING_NOTIFIER=true
TEAMCALLS_AUTHORIZATION_DRIVER=collaboration

# LiveKit autohospedado (https/wss obligatorios fuera de desarrollo)
TEAMCALLS_MEDIA_DRIVER=livekit
TEAMCALLS_LIVEKIT_API_URL=https://rtc.staging.example.com
TEAMCALLS_LIVEKIT_CLIENT_URL=wss://rtc.staging.example.com
TEAMCALLS_LIVEKIT_API_KEY=APIstagingCAMBIAR
TEAMCALLS_LIVEKIT_API_SECRET=<el mismo secreto de LIVEKIT_KEYS, 32 o más caracteres>
TEAMCALLS_LIVEKIT_ALLOW_INSECURE_DEV_URLS=false
TEAMCALLS_LIVEKIT_CONNECT_TIMEOUT=3
TEAMCALLS_LIVEKIT_CONNECT_RETRIES=1
TEAMCALLS_LIVEKIT_BREAKER_SECONDS=30
TEAMCALLS_MAX_PARTICIPANTS=25

# Tiempos del navegador (ms)
TEAMCALLS_UI_REQUEST_TIMEOUT_MS=15000
TEAMCALLS_UI_CONNECT_TIMEOUT_MS=20000
TEAMCALLS_UI_MEDIA_TIMEOUT_MS=20000
TEAMCALLS_UI_SLOW_AFTER_MS=6000

# Reverb (CollaborationRealtime) detrás de TLS
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=<id>
REVERB_APP_KEY=<clave pública>
REVERB_APP_SECRET=<secreto>
REVERB_HOST=ws.staging.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=staging.example.com
TEAMCALLS_REVERB_HOST=ws.staging.example.com
TEAMCALLS_REVERB_PORT=443
TEAMCALLS_REVERB_SCHEME=https
