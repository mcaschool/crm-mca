APP_NAME="CRM MCA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Zona horaria: se guarda en UTC, se presenta por institucion (default America/New_York)
APP_TIMEZONE=UTC

# i18n: dos idiomas fijos (es/en). Interfaz por localizacion nativa; contenido por columnas _es/_en.
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_mca
DB_USERNAME=root
DB_PASSWORD=

# Base de datos de pruebas (usada por phpunit.xml / Pest)
DB_TEST_DATABASE=crm_mca_test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo transaccional dia 1: SMTP de Hostinger (D6). SPF/DKIM del dominio emisor a configurar en DNS.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@mcaschool.us"
MAIL_FROM_NAME="${APP_NAME}"

# ---- CRM MCA: parametros de dominio ----
# Retencion de mensajes de conversacion en meses (D5). Coordinado con consentimiento (D2).
CRM_MESSAGE_RETENTION_MONTHS=24
# Nuevo lead tras N dias de inactividad o cambio de producto (D4).
CRM_LEAD_REOPEN_DAYS=30
# Rate limit del widget (D8): obligatorio. Peticiones/min por sesion e IP.
CRM_WIDGET_RATE_PER_MIN=30
CRM_WIDGET_MESSAGE_RATE_PER_MIN=8

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Dominio del panel (D7). Vacio en local; en produccion p.ej. crm.mcaschool.us
PANEL_DOMAIN=
