APP_NAME="CRM MCA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Zona horaria: se guarda en UTC, se presenta por institucion (default America/New_York)
APP_TIMEZONE=UTC

# i18n: dos idiomas fijos (es/en). Interfaz por localizacion nativa; contenido por columnas _es/_en.
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_mca
DB_USERNAME=root
DB_PASSWORD=

# Base de datos de pruebas (usada por phpunit.xml / Pest)
DB_TEST_DATABASE=crm_mca_test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo transaccional dia 1: SMTP de Hostinger (D6). SPF/DKIM del dominio emisor a configurar en DNS.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@mcaschool.education"
MAIL_FROM_NAME="${APP_NAME}"

# ---- CRM MCA: parametros de dominio ----
# Retencion de mensajes de conversacion en meses (D5). Coordinado con consentimiento (D2).
CRM_MESSAGE_RETENTION_MONTHS=24
# Nuevo lead tras N dias de inactividad o cambio de producto (D4).
CRM_LEAD_REOPEN_DAYS=30
# Rate limit del widget (D8): obligatorio. Peticiones/min por sesion e IP.
CRM_WIDGET_RATE_PER_MIN=30
CRM_WIDGET_MESSAGE_RATE_PER_MIN=8

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Dominio del panel (D7). Vacio en local; en produccion p.ej. crm.mcaschool.us
PANEL_DOMAIN=

# TeamCalls · servidor de medios (LiveKit AUTOHOSPEDADO en un VPS propio; nunca en el hosting compartido).
# none = sin salas reales (unirse y credenciales responden 503). livekit = solo si TODO está completo.
# En LiveKit: room.auto_create=false y webhook a https://<panel>/api/teamcalls/media/livekit con esta API key.
TEAMCALLS_MEDIA_DRIVER=none
TEAMCALLS_LIVEKIT_API_URL=
TEAMCALLS_LIVEKIT_CLIENT_URL=
TEAMCALLS_LIVEKIT_API_KEY=
# Secreto HS256 (>= 32 caracteres). Solo en el .env del servidor; nunca en el repositorio.
TEAMCALLS_LIVEKIT_API_SECRET=
TEAMCALLS_LIVEKIT_TIMEOUT=5
TEAMCALLS_LIVEKIT_CONNECT_TIMEOUT=3
TEAMCALLS_LIVEKIT_RETRIES=2
TEAMCALLS_LIVEKIT_RETRY_SLEEP_MS=200
TEAMCALLS_LIVEKIT_SERVER_TOKEN_TTL=60
TEAMCALLS_LIVEKIT_EMPTY_TIMEOUT=120
TEAMCALLS_LIVEKIT_DEPARTURE_TIMEOUT=20
TEAMCALLS_LIVEKIT_WEBHOOK_LEEWAY=30
# Solo desarrollo (APP_ENV=local/testing): admite http/ws para un LiveKit local sin TLS. Nunca en producción.
TEAMCALLS_LIVEKIT_ALLOW_INSECURE_DEV_URLS=false
# Autorización de personas: provisional (panel + CRM) hasta integrar CollaborationCore; collaboration = collaboration.use.
TEAMCALLS_AUTHORIZATION_DRIVER=provisional
# Vigencia de las credenciales de sala (60-3600 s) y límites de la llamada.
TEAMCALLS_JOIN_TOKEN_TTL=300
TEAMCALLS_MAX_PARTICIPANTS=25
TEAMCALLS_CONNECT_SECONDS=90
# Margen para reconectarse tras una desconexión confirmada por LiveKit antes de salir de la llamada.
TEAMCALLS_RECONNECT_GRACE=20
# Interfaz web de llamadas (fase 3C): SOLO en local/testing mientras falten los permisos de CollaborationCore.
TEAMCALLS_UI_ENABLED=false
TEAMCALLS_UI_POLL_MS=4000
# Medios sintéticos (?sintetico=1) para pruebas automatizadas sin cámara ni micrófono.
TEAMCALLS_UI_SYNTHETIC_MEDIA=false
